# API Gateway - Request Router & Auth Validator
FROM node:20-alpine

WORKDIR /app

# Install dependencies
COPY server/package.json server/package-lock.json ./
RUN npm ci --only=production

# Copy gateway code
COPY server/src/gateway ./src/gateway
COPY server/src/shared ./src/shared
COPY server/src/utils/logger.js ./src/utils/logger.js
COPY server/src/utils/auth.js ./src/utils/auth.js

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD node -e "require('http').get('http://localhost:' + process.env.PORT + '/health', (r) => {if (r.statusCode !== 200) throw new Error(r.statusCode)})"

# Expose port
EXPOSE 3000

# Start service
CMD ["node", "src/gateway/index.js"]
