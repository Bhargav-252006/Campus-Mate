/* ============ CSS VARIABLES ============ */
:root {
    --primary: #6366f1;
    --primary-dark: #4f46e5;
    --primary-light: #818cf8;
    --secondary: #64748b;
    --success: #10b981;
    --warning: #f59e0b;
    --danger: #ef4444;
    --info: #3b82f6;
    --bg-dark: #0f0f1a;
    --bg-sidebar: #1a1a2e;
    --bg-card: #16213e;
    --bg-input: #1f2937;
    --text-primary: #e4e4e7;
    --text-secondary: #a1a1aa;
    --text-muted: #71717a;
    --border: #2d2d44;
    --shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
    --shadow-lg: 0 20px 50px -20px rgba(0, 0, 0, 0.7);
    --radius: 16px;
    --radius-sm: 10px;
    --radius-lg: 20px;
    --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* ============ RESET & BASE ============ */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Inter', 'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;
    background: linear-gradient(135deg, var(--bg-dark) 0%, #1a1a2e 100%);
    color: var(--text-primary);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

/* ============ APP LAYOUT ============ */
.app-container {
    min-height: 100vh;
    display: flex;
    flex-direction: row;
    width: 100%;
}

/* Header */
.header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 24px;
    background: var(--bg-sidebar);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 100;
}

.menu-btn {
    background: none;
    border: none;
    color: var(--text-primary);
    cursor: pointer;
    padding: 8px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
}

.menu-btn:hover {
    background: var(--bg-input);
}

.logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--primary);
}

.user-info {
    color: var(--text-secondary);
    font-size: 0.9rem;
}

/* Main Wrapper */
.main-wrapper {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
}

/* Sidebar */
.sidebar {
    width: 260px;
    background: linear-gradient(180deg, var(--bg-sidebar) 0%, rgba(26, 26, 46, 0.95) 100%);
    backdrop-filter: blur(10px);
    border-right: 1px solid var(--border);
    padding: 24px 16px;
    transition: var(--transition);
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
}

.logo-container {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 6px 8px 18px;
    margin-bottom: 12px;
}

.logo-container span {
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.2px;
    color: var(--text-primary);
}

.logo-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
}

.nav-scroll {
    flex: 1;
    padding-bottom: 12px;
}

.user-profile {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
}

.sidebar.closed {
    width: 70px;
}

.sidebar nav {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.nav-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: all 0.2s;
}

.nav-item:hover {
    background: var(--bg-input);
    color: var(--text-primary);
}

.nav-item.active {
    background: var(--primary);
    color: white;
}

.sidebar.closed .nav-item span {
    display: none;
}

/* Main Content */
.main-content {
    flex: 1;
    padding: 24px;
    overflow-y: auto;
    max-height: 100vh;
}

.top-header {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 18px;
    background: rgba(15, 15, 26, 0.75);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

.header-title h1 {
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.2px;
}

.header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
}

.page-content {
    flex: 1;
    padding: 24px;
    overflow-y: auto;
    min-width: 0;
}

.page-content .max-w-7xl {
    width: 100%;
}

/* Basic element defaults */
a {
    color: inherit;
}

button,
input,
select,
textarea {
    font-family: inherit;
}

/* ============ COMMON COMPONENTS ============ */
.loading {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 200px;
    color: var(--text-secondary);
}

.page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 24px;
}

.page-header h1 {
    font-size: 1.75rem;
    margin-bottom: 4px;
}

.subtitle {
    color: var(--text-secondary);
    font-size: 0.95rem;
}

/* Buttons */
.btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    border: none;
    border-radius: var(--radius-sm);
    font-size: 0.95rem;
    font-weight: 500;
    cursor: pointer;
    transition: var(--transition);
}

.btn-primary {
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
    color: white;
    box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4);
}

.btn-primary:hover {
    background: linear-gradient(135deg, var(--primary-dark) 0%, #4338ca 100%);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(99, 102, 241, 0.6);
}

.btn-secondary {
    background: var(--bg-input);
    color: var(--text-primary);
}

.btn-secondary:hover {
    background: var(--border);
}

/* ============ DASHBOARD ============ */
.dashboard h1 {
    font-size: 1.75rem;
    margin-bottom: 4px;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin-bottom: 24px;
}

.stat-card {
    background: linear-gradient(135deg, var(--bg-card) 0%, rgba(22, 33, 62, 0.8) 100%);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--radius);
    padding: 24px;
    display: flex;
    align-items: center;
    gap: 16px;
    box-shadow: var(--shadow);
    transition: var(--transition);
    cursor: pointer;
}

.stat-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: rgba(99, 102, 241, 0.3);
}

.stat-icon {
    padding: 12px;
    border-radius: var(--radius-sm);
}

.stat-icon.blue {
    background: rgba(59, 130, 246, 0.2);
    color: #3b82f6;
}

.stat-icon.red {
    background: rgba(239, 68, 68, 0.2);
    color: #ef4444;
}

.stat-icon.orange {
    background: rgba(245, 158, 11, 0.2);
    color: #f59e0b;
}

.stat-icon.green {
    background: rgba(16, 185, 129, 0.2);
    color: #10b981;
}

.stat-info h3 {
    font-size: 1.75rem;
    font-weight: 700;
}

.stat-info p {
    color: var(--text-secondary);
    font-size: 0.9rem;
}

.dashboard-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
}

.dashboard-card {
    background: linear-gradient(135deg, var(--bg-card) 0%, rgba(22, 33, 62, 0.9) 100%);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: var(--transition);
}

.dashboard-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
    border-color: rgba(99, 102, 241, 0.2);
}

.card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    border-bottom: 1px solid var(--border);
}

.card-header h2 {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1rem;
    font-weight: 600;
}

.view-all {
    color: var(--primary);
    text-decoration: none;
    font-size: 0.85rem;
}

.view-all:hover {
    text-decoration: underline;
}

.card-content {
    padding: 16px 20px;
}

.empty-state {
    text-align: center;
    color: var(--text-muted);
    padding: 20px;
}

.item-list {
    list-style: none;
}

.list-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
}

.list-item:last-child {
    border-bottom: none;
}

.list-item .time {
    color: var(--primary);
    font-weight: 500;
    min-width: 80px;
}

.list-item .subject {
    flex: 1;
}

.list-item .room {
    color: var(--text-muted);
    font-size: 0.85rem;
}

.chat-preview .card-content {
    text-align: center;
}

.chat-btn {
    display: inline-block;
    margin-top: 12px;
    padding: 12px 24px;
    background: var(--primary);
    color: white;
    text-decoration: none;
    border-radius: 50px;
    font-weight: 500;
}

.chat-btn:hover {
    background: var(--primary-dark);
}

/* ============ TIMETABLE ============ */
.timetable-container {
    overflow-x: auto;
    background: var(--bg-card);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
}

.timetable-grid {
    width: 100%;
    border-collapse: collapse;
    min-width: 800px;
}

.timetable-grid th,
.timetable-grid td {
    padding: 12px;
    text-align: center;
    border: 1px solid var(--border);
}

.timetable-grid th {
    background: var(--bg-sidebar);
    font-weight: 600;
    color: var(--text-primary);
}

.time-cell {
    background: var(--bg-sidebar);
    font-weight: 500;
    color: var(--primary);
    min-width: 100px;
}

.class-cell {
    min-width: 120px;
    height: 80px;
    vertical-align: top;
    position: relative;
}

.class-card {
    background: var(--primary);
    color: white;
    padding: 8px;
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.class-card strong {
    font-size: 0.9rem;
}

.class-card .teacher {
    font-size: 0.75rem;
    opacity: 0.8;
}

.class-actions {
    display: flex;
    gap: 4px;
    margin-top: auto;
    justify-content: flex-end;
}

.class-actions button {
    background: rgba(255, 255, 255, 0.2);
    border: none;
    color: white;
    padding: 4px;
    border-radius: 4px;
    cursor: pointer;
}

.class-actions button:hover {
    background: rgba(255, 255, 255, 0.3);
}

.add-class-btn {
    width: 100%;
    height: 100%;
    background: none;
    border: 2px dashed var(--border);
    color: var(--text-muted);
    font-size: 1.5rem;
    cursor: pointer;
    border-radius: var(--radius-sm);
    opacity: 0;
    transition: opacity 0.2s;
}

@media (hover: none) {
    .add-class-btn {
        opacity: 1;
    }
}

.class-cell:hover .add-class-btn {
    opacity: 1;
}

.add-class-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
}

/* ============ EXAMS ============ */
.exam-section {
    margin-bottom: 32px;
}

.exam-section h2 {
    margin-bottom: 16px;
    color: var(--text-secondary);
    font-size: 1.1rem;
}

.exam-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 16px;
}

.exam-card {
    background: var(--bg-card);
    border-radius: var(--radius);
    padding: 20px;
    box-shadow: var(--shadow);
    border-left: 4px solid var(--primary);
}

.exam-card.urgent {
    border-left-color: var(--danger);
    background: rgba(239, 68, 68, 0.1);
}

.exam-card.soon {
    border-left-color: var(--warning);
}

.exam-card.past {
    opacity: 0.6;
    border-left-color: var(--secondary);
}

.exam-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 12px;
}

.exam-header h3 {
    font-size: 1.1rem;
}

.exam-actions {
    display: flex;
    gap: 8px;
}

.exam-actions button {
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 4px;
}

.exam-actions button:hover {
    color: var(--text-primary);
}

.exam-details p {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin-bottom: 4px;
}

.exam-notes {
    font-style: italic;
}

.syllabus-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--primary);
    text-decoration: none;
    font-size: 0.85rem;
    margin-top: 8px;
}

.syllabus-link:hover {
    text-decoration: underline;
}

.exam-countdown {
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
    font-weight: 600;
    color: var(--text-secondary);
}

.exam-countdown .today,
.exam-countdown .tomorrow {
    color: var(--danger);
    display: flex;
    align-items: center;
    gap: 4px;
}

.past-section {
    opacity: 0.7;
}

/* ============ SCHEDULE ============ */
.schedule-stats {
    display: flex;
    gap: 24px;
    margin-bottom: 24px;
    padding: 16px 20px;
    background: var(--bg-card);
    border-radius: var(--radius);
}

.schedule-stats .stat {
    text-align: center;
}

.schedule-stats .stat-value {
    display: block;
    font-size: 1.5rem;
    font-weight: 700;
}

.schedule-stats .stat-value.pending {
    color: var(--warning);
}

.schedule-stats .stat-value.completed {
    color: var(--success);
}

.schedule-stats .stat-value.high {
    color: var(--danger);
}

.schedule-stats .stat-label {
    font-size: 0.85rem;
    color: var(--text-muted);
}

.filter-tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
}

.filter-tab {
    padding: 8px 16px;
    background: var(--bg-card);
    border: none;
    color: var(--text-secondary);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 0.2s;
}

.filter-tab:hover {
    background: var(--bg-input);
}

.filter-tab.active {
    background: var(--primary);
    color: white;
}

.task-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 80px;
}

.task-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px;
    background: var(--bg-card);
    border-radius: var(--radius-sm);
    transition: all 0.2s;
}

.task-item.completed {
    opacity: 0.6;
}

.check-btn {
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 4px;
}

.check-btn .checked {
    color: var(--success);
}

.task-content {
    flex: 1;
}

.task-name {
    display: block;
    font-weight: 500;
}

.task-name.done {
    text-decoration: line-through;
    color: var(--text-muted);
}

.task-meta {
    display: flex;
    gap: 12px;
    margin-top: 4px;
}

.priority-badge {
    font-size: 0.75rem;
    padding: 2px 8px;
    border-radius: 20px;
    text-transform: uppercase;
    font-weight: 600;
}

.priority-badge.low {
    background: rgba(16, 185, 129, 0.2);
    color: #10b981;
}

.priority-badge.medium {
    background: rgba(245, 158, 11, 0.2);
    color: #f59e0b;
}

.priority-badge.high {
    background: rgba(239, 68, 68, 0.2);
    color: #ef4444;
}

.due-time {
    font-size: 0.85rem;
    color: var(--text-muted);
}

.task-actions {
    display: flex;
    gap: 8px;
}

.task-actions button {
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 4px;
}

.task-actions button:hover {
    color: var(--text-primary);
}

.quick-add {
    position: fixed;
    bottom: 0;
    left: 260px;
    right: 0;
    padding: 16px 24px;
    background: var(--bg-sidebar);
    border-top: 1px solid var(--border);
}

.sidebar.closed~.main-wrapper .quick-add {
    left: 70px;
}

@media (max-width: 900px) {
    .quick-add {
        left: 0;
    }
}

.quick-add input {
    width: 100%;
    padding: 14px 20px;
    background: var(--bg-input);
    border: 1px solid var(--border);
    border-radius: 50px;
    color: var(--text-primary);
    font-size: 1rem;
}

.quick-add input:focus {
    outline: none;
    border-color: var(--primary);
}

/* ============ CHAT PAGE ============ */
.chat-page {
    display: flex;
    flex-direction: column;
    height: calc(100vh - 105px);
    background: var(--bg-card);
    border-radius: var(--radius);
    overflow: hidden;
}

.chat-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    background: var(--bg-sidebar);
    border-bottom: 1px solid var(--border);
}

.chat-title {
    display: flex;
    align-items: center;
    gap: 12px;
}

.chat-title h1 {
    font-size: 1.1rem;
    margin: 0;
}

.chat-title .status {
    font-size: 0.8rem;
    color: var(--text-muted);
}

.chat-actions {
    display: flex;
    gap: 8px;
}

.icon-btn {
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 8px;
    border-radius: var(--radius-sm);
}

.icon-btn:hover {
    background: var(--bg-input);
    color: var(--text-primary);
}

.icon-btn.active {
    color: var(--primary);
}

.icon-btn.danger:hover {
    color: var(--danger);
}

.messages-container {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.message {
    max-width: 80%;
    display: flex;
    flex-direction: column;
}

.message.user {
    align-self: flex-end;
}

.message.bot {
    align-self: flex-start;
}

.agent-badge {
    font-size: 0.75rem;
    padding: 4px 10px;
    border-radius: 20px;
    color: white;
    margin-bottom: 6px;
    width: fit-content;
}

.message-bubble {
    padding: 12px 16px;
    border-radius: var(--radius);
    position: relative;
}

.message.user .message-bubble {
    background: var(--primary);
    color: white;
    border-bottom-right-radius: 4px;
}

.message.bot .message-bubble {
    background: var(--bg-input);
    color: var(--text-primary);
    border-bottom-left-radius: 4px;
}

.message-bubble p {
    white-space: pre-wrap;
    margin-bottom: 4px;
}

/* Markdown content styles */
.markdown-content {
    line-height: 1.6;
}

.markdown-content p {
    margin: 0 0 8px 0;
}

.markdown-content p:last-child {
    margin-bottom: 4px;
}

.markdown-content h1,
.markdown-content h2,
.markdown-content h3 {
    margin: 12px 0 8px 0;
    font-weight: 600;
}

.markdown-content h1 {
    font-size: 1.3em;
}

.markdown-content h2 {
    font-size: 1.15em;
}

.markdown-content h3 {
    font-size: 1.05em;
}

.markdown-content ul,
.markdown-content ol {
    margin: 8px 0;
    padding-left: 20px;
}

.markdown-content li {
    margin: 4px 0;
}

.markdown-content strong {
    font-weight: 600;
    color: inherit;
}

.markdown-content em {
    font-style: italic;
}

.markdown-content code {
    background: rgba(0, 0, 0, 0.15);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: 'Fira Code', 'Consolas', monospace;
    font-size: 0.9em;
}

.markdown-content pre {
    background: rgba(0, 0, 0, 0.2);
    padding: 12px;
    border-radius: 8px;
    overflow-x: auto;
    margin: 8px 0;
}

.markdown-content pre code {
    background: none;
    padding: 0;
}

.markdown-content blockquote {
    border-left: 3px solid var(--primary);
    padding-left: 12px;
    margin: 8px 0;
    color: var(--text-secondary);
    font-style: italic;
}

.markdown-content a {
    color: var(--primary);
    text-decoration: underline;
}

.markdown-content hr {
    border: none;
    border-top: 1px solid var(--border-color);
    margin: 12px 0;
}

.markdown-content table {
    border-collapse: collapse;
    width: 100%;
    margin: 8px 0;
}

.markdown-content th,
.markdown-content td {
    border: 1px solid var(--border-color);
    padding: 8px;
    text-align: left;
}

.markdown-content th {
    background: rgba(0, 0, 0, 0.1);
    font-weight: 600;
}

.message-bubble .timestamp {
    font-size: 0.7rem;
    color: var(--text-muted);
    display: block;
    text-align: right;
}

.message.user .message-bubble .timestamp {
    color: rgba(255, 255, 255, 0.7);
}

/* Typing indicator */
.typing {
    display: flex;
    gap: 4px;
    padding: 16px 20px;
}

.typing .dot {
    width: 8px;
    height: 8px;
    background: var(--text-muted);
    border-radius: 50%;
    animation: bounce 1.4s infinite ease-in-out both;
}

.typing .dot:nth-child(1) {
    animation-delay: -0.32s;
}

.typing .dot:nth-child(2) {
    animation-delay: -0.16s;
}

@keyframes bounce {

    0%,
    80%,
    100% {
        transform: scale(0);
    }

    40% {
        transform: scale(1);
    }
}

.chat-input-container {
    padding: 16px 20px;
    background: var(--bg-sidebar);
    border-top: 1px solid var(--border);
}

.chat-input {
    display: flex;
    gap: 12px;
    align-items: center;
}

.chat-input input {
    flex: 1;
    padding: 14px 20px;
    background: var(--bg-input);
    border: 1px solid var(--border);
    border-radius: 50px;
    color: var(--text-primary);
    font-size: 1rem;
}

.chat-input input:focus {
    outline: none;
    border-color: var(--primary);
}

.voice-btn,
.send-btn {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
}

.voice-btn {
    background: var(--bg-input);
    color: var(--text-primary);
}

.voice-btn:hover {
    background: var(--border);
}

.voice-btn.listening {
    background: var(--danger);
    color: white;
    animation: pulse 1.5s infinite;
}

@keyframes pulse {
    0% {
        box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.4);
    }

    70% {
        box-shadow: 0 0 0 10px rgba(239, 68, 68, 0);
    }

    100% {
        box-shadow: 0 0 0 0 rgba(239, 68, 68, 0);
    }
}

.send-btn {
    background: var(--primary);
    color: white;
}

.send-btn:hover:not(:disabled) {
    background: var(--primary-dark);
}

.send-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

.chat-hint {
    text-align: center;
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 8px;
}

/* ============ MODAL ============ */
.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.7);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 20px;
}

.modal {
    background: var(--bg-card);
    border-radius: var(--radius);
    width: 100%;
    max-width: 500px;
    max-height: 90vh;
    overflow-y: auto;
}

.modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    border-bottom: 1px solid var(--border);
}

.modal-header h2 {
    font-size: 1.2rem;
}

.close-btn {
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 4px;
}

.close-btn:hover {
    color: var(--text-primary);
}

.modal form {
    padding: 20px;
}

.form-group {
    margin-bottom: 16px;
}

.form-group label {
    display: block;
    margin-bottom: 6px;
    font-weight: 500;
    color: var(--text-secondary);
}

.form-group input,
.form-group select,
.form-group textarea {
    width: 100%;
    padding: 12px;
    background: var(--bg-input);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-size: 1rem;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    outline: none;
    border-color: var(--primary);
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
}

.modal-actions {
    display: flex;
    gap: 12px;
    justify-content: flex-end;
    margin-top: 24px;
}

/* ============ PRIORITY IN DASHBOARD ============ */
.priority {
    font-size: 0.7rem;
    padding: 2px 8px;
    border-radius: 20px;
    text-transform: uppercase;
    font-weight: 600;
}

.priority-low {
    background: rgba(16, 185, 129, 0.2);
    color: #10b981;
}

.priority-medium {
    background: rgba(245, 158, 11, 0.2);
    color: #f59e0b;
}

.priority-high {
    background: rgba(239, 68, 68, 0.2);
    color: #ef4444;
}

/* ============ RESPONSIVE ============ */
@media (max-width: 768px) {
    .sidebar {
        position: fixed;
        left: -260px;
        top: 0;
        z-index: 99;
        height: 100vh;
    }

    .sidebar.open {
        left: 0;
    }

    .page-content {
        padding: 16px;
    }

    .quick-add {
        left: 0;
    }

    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .form-row {
        grid-template-columns: 1fr;
    }

    .message {
        max-width: 90%;
    }
}

/* ============ TAILWIND-LIKE UTILS (MINIMAL) ============ */
.flex {
    display: flex;
}

.flex-col {
    flex-direction: column;
}

.items-center {
    align-items: center;
}

.justify-center {
    justify-content: center;
}

.justify-between {
    justify-content: space-between;
}

.gap-2 {
    gap: 0.5rem;
}

.gap-3 {
    gap: 0.75rem;
}

.gap-4 {
    gap: 1rem;
}

.flex-1 {
    flex: 1 1 auto;
}

.min-w-0 {
    min-width: 0;
}

.truncate {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.text-white {
    color: #fff;
}

.text-sm {
    font-size: 0.875rem;
}

.text-xs {
    font-size: 0.75rem;
}

.font-semibold {
    font-weight: 600;
}

.font-bold {
    font-weight: 700;
}

.cursor-pointer {
    cursor: pointer;
}

.shadow-lg {
    box-shadow: var(--shadow-lg);
}

.rounded-full {
    border-radius: 9999px;
}

.rounded-lg {
    border-radius: 0.75rem;
}

.p-0 {
    padding: 0;
}

.p-2 {
    padding: 0.5rem;
}

.px-4 {
    padding-left: 1rem;
    padding-right: 1rem;
}

.py-2 {
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
}

.mr-2 {
    margin-right: 0.5rem;
}

.mr-4 {
    margin-right: 1rem;
}

.w-48 {
    width: 12rem;
}

.w-10 {
    width: 2.5rem;
}

.h-10 {
    height: 2.5rem;
}

.bg-transparent {
    background: transparent;
}

.border-none {
    border: none;
}

.shadow-none {
    box-shadow: none;
}

.transition-colors {
    transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
}

.mx-auto {
    margin-left: auto;
    margin-right: auto;
}

.max-w-7xl {
    max-width: 80rem;
}

.text-gray-400 {
    color: #9ca3af;
}

.bg-white\/5 {
    background: rgba(255, 255, 255, 0.05);
}

.border-white\/10 {
    border-color: rgba(255, 255, 255, 0.10);
}

.hover\:bg-white\/5:hover {
    background: rgba(255, 255, 255, 0.05);
}

.hover\:text-white:hover {
    color: #fff;
}

.hidden {
    display: none;
}

@media (min-width: 768px) {
    .md\:flex {
        display: flex;
    }
}

.bg-gradient-to-br {
    background-image: linear-gradient(135deg, var(--tw-gradient-from, #6366f1), var(--tw-gradient-to, #a855f7));
}

.bg-gradient-to-r {
    background-image: linear-gradient(90deg, var(--tw-gradient-from, #06b6d4), var(--tw-gradient-to, #3b82f6));
}

.from-indigo-500 {
    --tw-gradient-from: #6366f1;
}

.to-purple-500 {
    --tw-gradient-to: #a855f7;
}

.from-cyan-500 {
    --tw-gradient-from: #06b6d4;
}

.to-blue-500 {
    --tw-gradient-to: #3b82f6;
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(6px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.animate-fade-in {
    animation: fadeIn 320ms ease-out both;
}

/* ============ LANDING PAGE ============ */
.landing-page {
    min-height: 100vh;
    background:
        radial-gradient(900px 400px at 20% 10%, rgba(99, 102, 241, 0.35), transparent 60%),
        radial-gradient(900px 400px at 80% 20%, rgba(16, 185, 129, 0.25), transparent 60%),
        linear-gradient(135deg, var(--bg-dark) 0%, #121229 100%);
}

.hero-section {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 40px;
    padding: 72px 24px 42px;
    max-width: 1200px;
    margin: 0 auto;
    align-items: center;
}

.hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--text-secondary);
    font-size: 0.92rem;
    margin-bottom: 18px;
}

.badge-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--success), var(--primary));
    box-shadow: 0 0 0 6px rgba(16, 185, 129, 0.12);
}

.hero-title {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    line-height: 1.08;
    letter-spacing: -0.8px;
    font-weight: 900;
    margin-bottom: 14px;
}

.gradient-text {
    background: linear-gradient(135deg, #a78bfa 0%, #22d3ee 45%, #34d399 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
}

.hero-subtitle {
    color: var(--text-secondary);
    font-size: 1.05rem;
    max-width: 46ch;
    margin-bottom: 22px;
}

.hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
}

.btn-primary-large,
.btn-secondary-large,
.btn-cta-large {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 18px;
    border-radius: 14px;
    font-weight: 700;
    text-decoration: none;
    border: 1px solid transparent;
    transition: var(--transition);
}

.btn-primary-large {
    background: linear-gradient(135deg, var(--primary) 0%, #22d3ee 100%);
    color: #0b1220;
    box-shadow: 0 18px 45px rgba(99, 102, 241, 0.25);
}

.btn-primary-large:hover {
    transform: translateY(-2px);
    box-shadow: 0 22px 60px rgba(99, 102, 241, 0.35);
}

.btn-secondary-large {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.10);
    color: var(--text-primary);
}

.btn-secondary-large:hover {
    background: rgba(255, 255, 255, 0.10);
    transform: translateY(-2px);
}

.hero-visual {
    display: flex;
    justify-content: center;
}

.dashboard-mockup {
    width: min(520px, 100%);
    border-radius: 18px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: var(--shadow-lg);
}

.mockup-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px;
    background: rgba(0, 0, 0, 0.25);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
}

.mockup-dots {
    display: flex;
    gap: 6px;
}

.mockup-dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
}

.mockup-title {
    color: var(--text-secondary);
    font-size: 0.86rem;
}

.mockup-content {
    padding: 16px;
}

.mockup-chat {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 14px;
}

.chat-bubble {
    align-self: flex-start;
    max-width: 90%;
    padding: 10px 12px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--text-primary);
    font-size: 0.92rem;
}

.chat-bubble.ai {
    align-self: flex-end;
    background: rgba(99, 102, 241, 0.18);
    border-color: rgba(99, 102, 241, 0.20);
}

.mockup-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
}

.landing-page .stat-card {
    padding: 14px;
    border-radius: 14px;
}

.core-values-section,
.ai-understanding-section,
.workflow-section,
.features-section,
.trust-section,
.final-cta-section {
    padding: 56px 24px;
    max-width: 1200px;
    margin: 0 auto;
}

.section-intro {
    text-align: center;
    margin-bottom: 26px;
}

.section-title {
    font-size: 2rem;
    font-weight: 900;
    letter-spacing: -0.5px;
    margin-bottom: 10px;
}

.section-description {
    color: var(--text-secondary);
}

.value-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
}

.value-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    padding: 18px;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.25);
    transition: var(--transition);
}

.value-card:hover {
    transform: translateY(-4px);
    border-color: rgba(99, 102, 241, 0.25);
}

.value-icon {
    width: 48px;
    height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    margin-bottom: 12px;
}

.value-title {
    font-weight: 800;
    margin-bottom: 6px;
}

.value-description {
    color: var(--text-secondary);
    font-size: 0.95rem;
}

.ai-content {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 22px;
    align-items: center;
}

.ai-intro {
    color: var(--text-secondary);
    margin: 10px 0 14px;
}

.ai-features-list {
    list-style: none;
    display: grid;
    gap: 10px;
    margin-bottom: 14px;
}

.ai-features-list li {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text-primary);
}

.ai-features-list svg {
    color: var(--success);
}

.ai-trust {
    color: var(--text-muted);
    font-size: 0.92rem;
}

.ai-visual {
    display: flex;
    justify-content: center;
    align-items: center;
}

.ai-brain-illustration {
    position: relative;
    width: 220px;
    height: 220px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(99, 102, 241, 0.9);
}

.pulse-ring {
    position: absolute;
    inset: 18px;
    border-radius: 999px;
    border: 2px solid rgba(99, 102, 241, 0.25);
    animation: ring 1800ms ease-out infinite;
}

@keyframes ring {
    0% {
        transform: scale(0.92);
        opacity: 0.45;
    }

    70% {
        transform: scale(1.08);
        opacity: 0.15;
    }

    100% {
        transform: scale(1.12);
        opacity: 0;
    }
}

.workflow-timeline {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
}

.workflow-step {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    padding: 18px;
}

.step-number {
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: rgba(99, 102, 241, 0.18);
    color: #c7d2fe;
    font-weight: 900;
    margin-bottom: 10px;
}

.step-time {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 6px;
}

.step-title {
    font-weight: 900;
    margin-bottom: 6px;
}

.step-description {
    color: var(--text-secondary);
}

.feature-categories {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
}

.feature-category {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    padding: 18px;
}

.category-title {
    font-weight: 900;
    margin-bottom: 12px;
}

.feature-list {
    display: grid;
    gap: 10px;
}

.feature-item {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text-primary);
}

.trust-content {
    display: flex;
    justify-content: center;
    gap: 18px;
    flex-wrap: wrap;
    padding: 18px;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
}

.trust-point {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text-secondary);
}

.trust-point svg {
    color: var(--success);
}

.final-cta-section {
    text-align: center;
}

.cta-title {
    font-size: 2rem;
    font-weight: 900;
    letter-spacing: -0.5px;
    margin-bottom: 10px;
}

.cta-subtitle {
    color: var(--text-secondary);
    margin-bottom: 18px;
}

.btn-cta-large {
    background: linear-gradient(135deg, #34d399 0%, #22d3ee 45%, #818cf8 100%);
    color: #0b1220;
    padding: 14px 22px;
    border-radius: 14px;
    box-shadow: 0 18px 45px rgba(16, 185, 129, 0.18);
}

.btn-cta-large:hover {
    transform: translateY(-2px);
    box-shadow: 0 22px 60px rgba(16, 185, 129, 0.26);
}

.landing-footer {
    padding: 34px 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(0, 0, 0, 0.18);
}

.footer-content {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
}

.footer-brand h3 {
    font-weight: 900;
    margin-bottom: 6px;
}

.footer-brand p {
    color: var(--text-secondary);
}

.footer-links {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
}

.footer-links a {
    color: var(--text-secondary);
    text-decoration: none;
}

.footer-links a:hover {
    color: var(--text-primary);
}

.footer-bottom {
    max-width: 1200px;
    margin: 18px auto 0;
    color: var(--text-muted);
    font-size: 0.9rem;
}

@media (max-width: 980px) {
    .hero-section {
        grid-template-columns: 1fr;
        padding-top: 56px;
    }

    .value-cards {
        grid-template-columns: repeat(2, 1fr);
    }

    .ai-content {
        grid-template-columns: 1fr;
    }

    .workflow-timeline {
        grid-template-columns: repeat(2, 1fr);
    }

    .feature-categories {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 520px) {
    .hero-actions {
        flex-direction: column;
        align-items: stretch;
    }

    .mockup-stats {
        grid-template-columns: 1fr;
    }

    .value-cards {
        grid-template-columns: 1fr;
    }

    .workflow-timeline {
        grid-template-columns: 1fr;
    }
}

/* ============ MOOD TRACKER ============ */
.mood-page {
    max-width: 900px;
    margin: 0 auto;
}

.mood-today-section {
    margin-bottom: 24px;
}

.today-mood-card {
    background: linear-gradient(135deg, var(--bg-card) 0%, rgba(22, 33, 62, 0.9) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius);
    padding: 24px;
    box-shadow: var(--shadow);
}

.today-mood-card.not-logged {
    cursor: pointer;
    text-align: center;
    border: 2px dashed rgba(99, 102, 241, 0.3);
    background: rgba(99, 102, 241, 0.05);
    transition: var(--transition);
}

.today-mood-card.not-logged:hover {
    border-color: var(--primary);
    background: rgba(99, 102, 241, 0.1);
}

.not-logged-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 20px;
    color: var(--text-secondary);
}

.not-logged-content svg {
    color: var(--primary);
    opacity: 0.7;
}

.not-logged-content h3 {
    color: var(--text-primary);
}

.today-header {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin-bottom: 16px;
}

.today-mood-display {
    display: flex;
    align-items: center;
    gap: 20px;
}

.big-emoji {
    font-size: 4rem;
}

.today-details h3 {
    font-size: 1.5rem;
    margin-bottom: 8px;
}

.energy-display {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--warning);
    font-weight: 500;
}

.today-notes {
    color: var(--text-secondary);
    font-style: italic;
    margin-top: 8px;
}

.mood-stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 24px;
}

.mood-stat-card {
    background: var(--bg-card);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--radius);
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 16px;
    box-shadow: var(--shadow);
}

.stat-icon-wrapper {
    padding: 14px;
    border-radius: var(--radius-sm);
}

.stat-icon-wrapper.blue {
    background: rgba(59, 130, 246, 0.2);
    color: #3b82f6;
}

.stat-icon-wrapper.orange {
    background: rgba(245, 158, 11, 0.2);
    color: #f59e0b;
}

.stat-icon-wrapper.green {
    background: rgba(16, 185, 129, 0.2);
    color: #10b981;
}

.stat-icon-wrapper.purple {
    background: rgba(139, 92, 246, 0.2);
    color: #8b5cf6;
}

.stat-info {
    display: flex;
    flex-direction: column;
}

.stat-value {
    font-size: 1.75rem;
    font-weight: 700;
}

.stat-label {
    color: var(--text-secondary);
    font-size: 0.85rem;
}

.insight-card {
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.15) 0%, rgba(139, 92, 246, 0.1) 100%);
    border: 1px solid rgba(99, 102, 241, 0.2);
    border-radius: var(--radius);
    padding: 20px;
    margin-bottom: 24px;
}

.insight-card h3 {
    margin-bottom: 8px;
}

.insight-card p {
    color: var(--text-secondary);
}

.mood-history-section h2 {
    margin-bottom: 16px;
}

.mood-history-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.mood-history-item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px;
    background: var(--bg-card);
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.05);
}

.mood-emoji {
    font-size: 2rem;
}

.mood-info {
    flex: 1;
}

.mood-label {
    display: block;
    font-weight: 600;
}

.mood-date {
    color: var(--text-muted);
    font-size: 0.85rem;
}

/* Mood Log Modal */
.mood-selector {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 20px;
}

.mood-option {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 16px 8px;
    background: var(--bg-input);
    border: 2px solid transparent;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: var(--transition);
}

.mood-option:hover {
    background: var(--border);
}

.mood-option.selected {
    border-color: var(--primary);
    background: rgba(99, 102, 241, 0.15);
}

.mood-option .emoji {
    font-size: 2rem;
}

.mood-option .label {
    font-size: 0.8rem;
    color: var(--text-secondary);
}

.energy-slider {
    margin-bottom: 20px;
}

.energy-slider label {
    display: block;
    margin-bottom: 8px;
    font-weight: 500;
}

.energy-slider input[type="range"] {
    width: 100%;
    height: 8px;
    background: var(--bg-input);
    border-radius: 4px;
    appearance: none;
}

.energy-slider input[type="range"]::-webkit-slider-thumb {
    appearance: none;
    width: 20px;
    height: 20px;
    background: var(--primary);
    border-radius: 50%;
    cursor: pointer;
}

/* ============ ANALYTICS PAGE ============ */
.analytics-page {
    max-width: 1100px;
    margin: 0 auto;
}

.time-filter {
    display: flex;
    gap: 8px;
}

.filter-btn {
    padding: 8px 16px;
    background: var(--bg-card);
    border: 1px solid rgba(255, 255, 255, 0.05);
    color: var(--text-secondary);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: var(--transition);
}

.filter-btn:hover {
    background: var(--bg-input);
}

.filter-btn.active {
    background: var(--primary);
    color: white;
    border-color: var(--primary);
}

.analytics-stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 24px;
}

.analytics-stat-card {
    background: var(--bg-card);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--radius);
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 16px;
    box-shadow: var(--shadow);
    transition: var(--transition);
}

.analytics-stat-card:hover {
    transform: translateY(-2px);
    border-color: rgba(99, 102, 241, 0.2);
}

.analytics-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
}

.analytics-card {
    background: var(--bg-card);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--radius);
    padding: 24px;
    box-shadow: var(--shadow);
}

.analytics-card h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
    font-size: 1.1rem;
}

.empty-chart {
    text-align: center;
    color: var(--text-muted);
    padding: 40px;
}

.mood-bars {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.mood-bar-row {
    display: flex;
    align-items: center;
    gap: 12px;
}

.mood-bar-row .mood-label {
    min-width: 100px;
    font-size: 0.9rem;
}

.mood-bar-track {
    flex: 1;
    height: 8px;
    background: var(--bg-input);
    border-radius: 4px;
    overflow: hidden;
}

.mood-bar-fill {
    height: 100%;
    border-radius: 4px;
    transition: width 0.5s ease;
}

.mood-count {
    min-width: 30px;
    text-align: right;
    color: var(--text-muted);
    font-size: 0.9rem;
}

.weekly-chart {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    height: 150px;
    padding-top: 20px;
}

.day-column {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
}

.bar-container {
    height: 100px;
    width: 24px;
    background: var(--bg-input);
    border-radius: 4px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
}

.activity-bar {
    width: 100%;
    background: linear-gradient(180deg, var(--primary) 0%, var(--primary-light) 100%);
    border-radius: 4px;
    min-height: 4px;
    transition: height 0.5s ease;
}

.day-column span {
    margin-top: 8px;
    font-size: 0.8rem;
    color: var(--text-muted);
}

/* ============ HABIT TRACKER ============ */
.habits-page {
    max-width: 1100px;
    margin: 0 auto;
}

.habits-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 24px;
}

.habit-stat-card {
    background: var(--bg-card);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--radius);
    padding: 20px;
    text-align: center;
    box-shadow: var(--shadow);
}

.habit-stat-card .stat-value {
    font-size: 2rem;
    font-weight: 700;
    color: var(--primary);
}

.habit-stat-card .stat-label {
    color: var(--text-secondary);
    font-size: 0.85rem;
}

.habits-view-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.view-toggle {
    display: flex;
    gap: 8px;
}

.habits-grid {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.habit-card {
    background: var(--bg-card);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--radius);
    padding: 20px;
    box-shadow: var(--shadow);
    transition: var(--transition);
}

.habit-card:hover {
    border-color: rgba(99, 102, 241, 0.2);
}

.habit-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 16px;
}

.habit-info {
    display: flex;
    align-items: center;
    gap: 12px;
}

.habit-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    font-size: 1.5rem;
}

.habit-name {
    font-weight: 600;
    font-size: 1.1rem;
}

.habit-streak {
    display: flex;
    align-items: center;
    gap: 4px;
    color: var(--warning);
    font-size: 0.9rem;
}

.habit-actions button {
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 6px;
}

.habit-actions button:hover {
    color: var(--text-primary);
}

.habit-calendar {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
}

.habit-day {
    width: 36px;
    height: 36px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: var(--bg-input);
    cursor: pointer;
    border: 2px solid transparent;
    transition: var(--transition);
    font-size: 0.75rem;
}

.habit-day:hover {
    border-color: var(--border);
}

.habit-day.completed {
    background: rgba(16, 185, 129, 0.3);
    border-color: var(--success);
}

.habit-day.today {
    border-color: var(--primary);
}

.habit-day .day-name {
    font-size: 0.65rem;
    color: var(--text-muted);
}

.habit-day .day-num {
    font-weight: 600;
}

.habit-progress {
    margin-top: 12px;
    display: flex;
    align-items: center;
    gap: 12px;
}

.progress-bar {
    flex: 1;
    height: 6px;
    background: var(--bg-input);
    border-radius: 3px;
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--success) 0%, var(--primary) 100%);
    border-radius: 3px;
    transition: width 0.3s ease;
}

.progress-text {
    font-size: 0.85rem;
    color: var(--text-secondary);
    min-width: 45px;
}

/* ============ DEADLINES PAGE ============ */
.deadlines-page {
    max-width: 900px;
    margin: 0 auto;
}

.deadline-stats {
    display: flex;
    gap: 16px;
    margin-bottom: 24px;
    flex-wrap: wrap;
}

.deadline-stat {
    background: var(--bg-card);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--radius);
    padding: 16px 24px;
    text-align: center;
    flex: 1;
    min-width: 120px;
}

.deadline-stat .stat-num {
    display: block;
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--primary);
}

.deadline-stat.overdue .stat-num {
    color: var(--danger);
}

.deadline-stat.warning .stat-num {
    color: var(--warning);
}

.deadline-stat.success .stat-num {
    color: var(--success);
}

.deadline-stat .stat-text {
    color: var(--text-secondary);
    font-size: 0.85rem;
}

.deadline-filters {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    flex-wrap: wrap;
}

.deadlines-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.deadline-card {
    display: flex;
    gap: 16px;
    padding: 20px;
    background: var(--bg-card);
    border-radius: var(--radius);
    border-left: 4px solid var(--primary);
    box-shadow: var(--shadow);
    transition: var(--transition);
}

.deadline-card:hover {
    transform: translateX(4px);
}

.deadline-card.urgent {
    border-left-color: var(--danger);
    background: rgba(239, 68, 68, 0.05);
}

.deadline-card.soon {
    border-left-color: var(--warning);
}

.deadline-card.overdue {
    border-left-color: var(--danger);
    opacity: 0.8;
}

.deadline-card.completed {
    border-left-color: var(--success);
    opacity: 0.7;
}

.deadline-check {
    display: flex;
    align-items: flex-start;
}

.deadline-check .check-btn {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    transition: var(--transition);
}

.deadline-check .check-btn:hover {
    color: var(--success);
}

.deadline-check .check-btn.checked {
    color: var(--success);
}

.deadline-content {
    flex: 1;
}

.deadline-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 8px;
}

.deadline-header h3 {
    font-size: 1.1rem;
}

.completed-text {
    text-decoration: line-through;
    color: var(--text-muted);
}

.deadline-meta {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.type-badge,
.subject-badge {
    font-size: 0.75rem;
    padding: 4px 10px;
    border-radius: 20px;
    background: var(--bg-input);
    color: var(--text-secondary);
}

.deadline-due {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-secondary);
    font-size: 0.9rem;
}

.deadline-due.overdue {
    color: var(--danger);
}

.deadline-actions {
    display: flex;
    gap: 8px;
}

.deadline-actions button {
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 4px;
}

.deadline-actions button:hover {
    color: var(--text-primary);
}

/* ============ FLASHCARDS PAGE ============ */
.flashcards-page {
    max-width: 1100px;
    margin: 0 auto;
}

.flashcards-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 24px;
}

.deck-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
}

.deck-card {
    background: var(--bg-card);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--radius);
    padding: 24px;
    box-shadow: var(--shadow);
    cursor: pointer;
    transition: var(--transition);
}

.deck-card:hover {
    transform: translateY(-4px);
    border-color: rgba(99, 102, 241, 0.3);
}

.deck-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 16px;
}

.deck-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    background: rgba(99, 102, 241, 0.2);
    color: var(--primary);
}

.deck-actions {
    display: flex;
    gap: 4px;
}

.deck-actions button {
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 6px;
}

.deck-actions button:hover {
    color: var(--text-primary);
}

.deck-info h3 {
    font-size: 1.1rem;
    margin-bottom: 4px;
}

.deck-subject {
    color: var(--text-secondary);
    font-size: 0.85rem;
    margin-bottom: 12px;
}

.deck-stats {
    display: flex;
    gap: 16px;
}

.deck-stats span {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    color: var(--text-muted);
}

.deck-stats .due {
    color: var(--warning);
}

/* Study Mode */
.study-mode {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 40px 20px;
}

.study-header {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 32px;
}

.study-progress {
    display: flex;
    align-items: center;
    gap: 12px;
}

.progress-dots {
    display: flex;
    gap: 6px;
}

.progress-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--bg-input);
}

.progress-dot.correct {
    background: var(--success);
}

.progress-dot.incorrect {
    background: var(--danger);
}

.progress-dot.current {
    background: var(--primary);
}

.flashcard {
    width: 100%;
    max-width: 500px;
    aspect-ratio: 3 / 2;
    perspective: 1000px;
    cursor: pointer;
}

.flashcard-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.6s;
    transform-style: preserve-3d;
}

.flashcard.flipped .flashcard-inner {
    transform: rotateY(180deg);
}

.flashcard-front,
.flashcard-back {
    position: absolute;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 32px;
    text-align: center;
}

.flashcard-front {
    background: linear-gradient(135deg, var(--bg-card) 0%, rgba(99, 102, 241, 0.1) 100%);
    border: 1px solid rgba(99, 102, 241, 0.2);
}

.flashcard-back {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.1) 0%, var(--bg-card) 100%);
    border: 1px solid rgba(16, 185, 129, 0.2);
    transform: rotateY(180deg);
}

.flashcard-content {
    font-size: 1.25rem;
    line-height: 1.6;
}

.flip-hint {
    margin-top: 16px;
    font-size: 0.85rem;
    color: var(--text-muted);
}

.rating-buttons {
    display: flex;
    gap: 12px;
    margin-top: 32px;
}

.rating-btn {
    padding: 12px 24px;
    border: none;
    border-radius: var(--radius-sm);
    cursor: pointer;
    font-weight: 500;
    transition: var(--transition);
}

.rating-btn.again {
    background: rgba(239, 68, 68, 0.2);
    color: var(--danger);
}

.rating-btn.hard {
    background: rgba(245, 158, 11, 0.2);
    color: var(--warning);
}

.rating-btn.good {
    background: rgba(59, 130, 246, 0.2);
    color: var(--info);
}

.rating-btn.easy {
    background: rgba(16, 185, 129, 0.2);
    color: var(--success);
}

.rating-btn:hover {
    transform: translateY(-2px);
}

/* ============ GRADE CALCULATOR ============ */
.grade-calculator {
    max-width: 1100px;
    margin: 0 auto;
}

.gpa-overview {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 20px;
    margin-bottom: 24px;
}

.gpa-card {
    background: var(--bg-card);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--radius);
    padding: 24px;
    text-align: center;
    box-shadow: var(--shadow);
}

.gpa-card.main {
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
}

.gpa-value {
    font-size: 3rem;
    font-weight: 800;
    margin-bottom: 4px;
}

.gpa-label {
    color: var(--text-secondary);
    font-size: 0.9rem;
}

.gpa-card.main .gpa-label {
    color: rgba(255, 255, 255, 0.8);
}

.target-input {
    display: flex;
    align-items: center;
    gap: 12px;
    justify-content: center;
    margin-top: 12px;
}

.target-input label {
    font-size: 0.9rem;
    color: var(--text-secondary);
}

.target-input input {
    width: 80px;
    padding: 8px;
    text-align: center;
    background: var(--bg-input);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
}

.courses-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 20px;
}

.course-card {
    background: var(--bg-card);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
}

.course-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    background: var(--bg-sidebar);
    border-bottom: 1px solid var(--border);
}

.course-name {
    font-weight: 600;
}

.course-credits {
    font-size: 0.85rem;
    color: var(--text-secondary);
}

.course-grade {
    display: flex;
    align-items: center;
    gap: 8px;
}

.grade-letter {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--success);
}

.grade-percent {
    font-size: 0.9rem;
    color: var(--text-secondary);
}

.course-categories {
    padding: 16px 20px;
}

.category-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
}

.category-row:last-child {
    border-bottom: none;
}

.category-name {
    display: flex;
    align-items: center;
    gap: 8px;
}

.category-weight {
    font-size: 0.75rem;
    padding: 2px 8px;
    background: var(--bg-input);
    border-radius: 10px;
    color: var(--text-muted);
}

.category-grades {
    display: flex;
    align-items: center;
    gap: 8px;
}

.grade-chip {
    padding: 4px 10px;
    background: rgba(99, 102, 241, 0.2);
    border-radius: 15px;
    font-size: 0.8rem;
    color: var(--primary);
}

.add-grade-btn {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-input);
    border: none;
    border-radius: 50%;
    color: var(--text-muted);
    cursor: pointer;
}

.add-grade-btn:hover {
    background: var(--border);
    color: var(--text-primary);
}

/* ============ RESOURCE LIBRARY ============ */
.resource-library {
    max-width: 1200px;
    margin: 0 auto;
}

.resource-toolbar {
    display: flex;
    gap: 12px;
    margin-bottom: 24px;
    flex-wrap: wrap;
}

.search-box {
    flex: 1;
    min-width: 200px;
    position: relative;
}

.search-box input {
    width: 100%;
    padding: 12px 16px 12px 44px;
    background: var(--bg-card);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-size: 0.95rem;
}

.search-box input:focus {
    outline: none;
    border-color: var(--primary);
}

.search-box svg {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
}

.resource-filters {
    display: flex;
    gap: 8px;
}

.resource-layout {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 24px;
}

.folders-sidebar {
    background: var(--bg-card);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--radius);
    padding: 16px;
}

.folders-sidebar h3 {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    font-size: 0.9rem;
}

.folder-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.folder-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    color: var(--text-secondary);
    transition: var(--transition);
}

.folder-item:hover {
    background: var(--bg-input);
}

.folder-item.active {
    background: rgba(99, 102, 241, 0.15);
    color: var(--primary);
}

.folder-color {
    width: 8px;
    height: 8px;
    border-radius: 50%;
}

.resource-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
}

.resource-card {
    background: var(--bg-card);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--radius);
    padding: 20px;
    box-shadow: var(--shadow);
    transition: var(--transition);
}

.resource-card:hover {
    transform: translateY(-2px);
    border-color: rgba(99, 102, 241, 0.2);
}

.resource-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 12px;
}

.resource-type-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
}

.resource-actions {
    display: flex;
    gap: 4px;
}

.resource-actions button {
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 4px;
}

.resource-actions button:hover {
    color: var(--text-primary);
}

.favorite-btn.active {
    color: var(--warning);
}

.resource-title {
    font-weight: 600;
    margin-bottom: 6px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.resource-description {
    color: var(--text-secondary);
    font-size: 0.85rem;
    margin-bottom: 12px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.resource-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 12px;
}

.resource-tag {
    font-size: 0.7rem;
    padding: 3px 8px;
    background: var(--bg-input);
    border-radius: 10px;
    color: var(--text-muted);
}

.resource-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--primary);
    text-decoration: none;
    font-size: 0.9rem;
}

.resource-link:hover {
    text-decoration: underline;
}

/* ============ FOCUS MODE ============ */
.focus-mode {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--bg-dark);
    transition: var(--transition);
}

.focus-mode.dark-overlay {
    background: #0a0a0f;
}

.focus-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 24px;
}

.focus-title {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 1.2rem;
    font-weight: 600;
}

.focus-controls {
    display: flex;
    gap: 8px;
}

.focus-main {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
}

.focus-task {
    margin-bottom: 24px;
}

.focus-task input {
    background: transparent;
    border: none;
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-primary);
    text-align: center;
    outline: none;
    width: 400px;
    max-width: 90vw;
}

.focus-task input::placeholder {
    color: var(--text-muted);
}

.focus-timer {
    position: relative;
    margin-bottom: 32px;
}

.timer-ring {
    transform: rotate(-90deg);
}

.timer-track {
    fill: none;
    stroke: var(--bg-input);
    stroke-width: 8;
}

.timer-progress {
    fill: none;
    stroke: var(--primary);
    stroke-width: 8;
    stroke-linecap: round;
    transition: stroke-dashoffset 1s linear;
}

.timer-progress.break {
    stroke: var(--success);
}

.timer-display {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.timer-time {
    font-size: 4rem;
    font-weight: 800;
    font-family: 'JetBrains Mono', monospace;
    letter-spacing: -2px;
}

.timer-label {
    font-size: 1rem;
    color: var(--text-secondary);
    margin-top: 8px;
}

.focus-actions {
    display: flex;
    gap: 16px;
}

.focus-btn {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition);
}

.focus-btn.play {
    background: var(--primary);
    color: white;
}

.focus-btn.play:hover {
    background: var(--primary-dark);
    transform: scale(1.05);
}

.focus-btn.reset {
    background: var(--bg-input);
    color: var(--text-primary);
}

.focus-btn.reset:hover {
    background: var(--border);
}

.focus-quote {
    position: absolute;
    bottom: 60px;
    max-width: 500px;
    text-align: center;
    padding: 0 20px;
}

.focus-quote blockquote {
    color: var(--text-secondary);
    font-style: italic;
    font-size: 1rem;
    margin-bottom: 8px;
}

.focus-quote cite {
    color: var(--text-muted);
    font-size: 0.85rem;
}

.focus-stats {
    position: absolute;
    bottom: 20px;
    display: flex;
    gap: 32px;
}

.focus-stat {
    text-align: center;
}

.focus-stat-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--primary);
}

.focus-stat-label {
    font-size: 0.8rem;
    color: var(--text-muted);
}

/* Focus Settings Panel */
.focus-settings {
    position: absolute;
    top: 60px;
    right: 24px;
    width: 300px;
    background: var(--bg-card);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius);
    padding: 20px;
    box-shadow: var(--shadow-lg);
}

.focus-settings h3 {
    margin-bottom: 16px;
}

.setting-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
}

.setting-row label {
    color: var(--text-secondary);
    font-size: 0.9rem;
}

.setting-row input[type="number"] {
    width: 70px;
    padding: 8px;
    text-align: center;
    background: var(--bg-input);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
}

.setting-row select {
    padding: 8px 12px;
    background: var(--bg-input);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
}

/* ============ POMODORO PAGE ============ */
.pomodoro-page {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
}

.pomodoro-header {
    margin-bottom: 24px;
}

.pomodoro-timer {
    position: relative;
    display: inline-block;
    margin-bottom: 32px;
}

.timer-svg {
    transform: rotate(-90deg);
}

.pomodoro-display {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.pomodoro-time {
    font-size: 4rem;
    font-weight: 800;
    font-family: 'JetBrains Mono', monospace;
}

.pomodoro-status {
    font-size: 1rem;
    color: var(--text-secondary);
    margin-top: 8px;
}

.pomodoro-controls {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-bottom: 32px;
}

.pomodoro-btn {
    padding: 14px 32px;
    border: none;
    border-radius: 50px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition);
}

.pomodoro-btn.primary {
    background: var(--primary);
    color: white;
}

.pomodoro-btn.primary:hover {
    background: var(--primary-dark);
}

.pomodoro-btn.secondary {
    background: var(--bg-input);
    color: var(--text-primary);
}

.pomodoro-btn.secondary:hover {
    background: var(--border);
}

.quick-subjects {
    display: flex;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 32px;
}

.subject-chip {
    padding: 8px 16px;
    background: var(--bg-card);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 20px;
    color: var(--text-secondary);
    cursor: pointer;
    transition: var(--transition);
}

.subject-chip:hover,
.subject-chip.active {
    background: rgba(99, 102, 241, 0.2);
    border-color: var(--primary);
    color: var(--primary);
}

.pomodoro-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
}

.pomodoro-stat {
    background: var(--bg-card);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--radius);
    padding: 20px;
}

.pomodoro-stat-value {
    font-size: 2rem;
    font-weight: 700;
    color: var(--primary);
}

.pomodoro-stat-label {
    color: var(--text-secondary);
    font-size: 0.85rem;
}

/* ============ NOTES PAGE ============ */
.notes-page {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 24px;
    height: calc(100vh - 150px);
}

.notes-sidebar {
    background: var(--bg-card);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.notes-sidebar-header {
    padding: 16px;
    border-bottom: 1px solid var(--border);
}

.notes-search {
    width: 100%;
    padding: 10px 14px;
    background: var(--bg-input);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    margin-bottom: 12px;
}

.notes-search:focus {
    outline: none;
    border-color: var(--primary);
}

.notes-filter {
    width: 100%;
    padding: 8px 12px;
    background: var(--bg-input);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
}

.notes-list {
    flex: 1;
    overflow-y: auto;
    padding: 12px;
}

.note-item {
    padding: 12px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    margin-bottom: 8px;
    transition: var(--transition);
    border: 1px solid transparent;
}

.note-item:hover {
    background: var(--bg-input);
}

.note-item.active {
    background: rgba(99, 102, 241, 0.15);
    border-color: rgba(99, 102, 241, 0.3);
}

.note-title {
    font-weight: 600;
    margin-bottom: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.note-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    color: var(--text-muted);
}

.notes-editor {
    background: var(--bg-card);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.editor-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    border-bottom: 1px solid var(--border);
}

.editor-title {
    flex: 1;
    background: transparent;
    border: none;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    outline: none;
}

.editor-actions {
    display: flex;
    gap: 8px;
}

.editor-content {
    flex: 1;
    display: flex;
    overflow: hidden;
}

.editor-textarea {
    flex: 1;
    padding: 20px;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-size: 1rem;
    line-height: 1.7;
    resize: none;
    outline: none;
    font-family: inherit;
}

.note-preview {
    flex: 1;
    padding: 20px;
    overflow-y: auto;
    border-left: 1px solid var(--border);
}

/* ============ SCROLLBAR STYLING ============ */
::-webkit-scrollbar {
    width: 8px;
    height: 8px;
}

::-webkit-scrollbar-track {
    background: var(--bg-dark);
}

::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
    background: var(--text-muted);
}

/* ============ TOAST NOTIFICATIONS ============ */
.toast-container {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.toast {
    padding: 14px 20px;
    border-radius: var(--radius-sm);
    color: white;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 10px;
    box-shadow: var(--shadow-lg);
    animation: slideIn 0.3s ease;
}

.toast.success {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
}

.toast.error {
    background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
}

.toast.warning {
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
}

.toast.info {
    background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
}

@keyframes slideIn {
    from {
        transform: translateX(100%);
        opacity: 0;
    }

    to {
        transform: translateX(0);
        opacity: 1;
    }
}

/* ============ ADDITIONAL RESPONSIVE FIXES ============ */
@media (max-width: 768px) {
    .mood-stats-grid {
        grid-template-columns: 1fr;
    }

    .analytics-stats-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .analytics-grid {
        grid-template-columns: 1fr;
    }

    .habits-stats {
        grid-template-columns: repeat(2, 1fr);
    }

    .gpa-overview {
        grid-template-columns: 1fr;
    }

    .resource-layout,
    .resources-layout {
        grid-template-columns: 1fr;
    }

    .folders-sidebar,
    .resources-sidebar {
        display: none;
    }

    .notes-page {
        grid-template-columns: 1fr;
    }

    .notes-sidebar {
        height: 200px;
    }

    .pomodoro-time,
    .timer-time {
        font-size: 3rem;
    }

    .flashcards-stats {
        grid-template-columns: repeat(2, 1fr);
    }
}

/* ============ DASHBOARD (V2) ============ */
.dashboard-page {
    max-width: 1200px;
    margin: 0 auto;
}

.dashboard-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 240px;
    color: var(--text-secondary);
}

.loading-spinner {
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 3px solid rgba(255, 255, 255, 0.12);
    border-top-color: var(--primary);
    animation: spin 0.9s linear infinite;
}

@keyframes spin {
    from {
        transform: rotate(0deg);
    }

    to {
        transform: rotate(360deg);
    }
}

.dashboard-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
    padding: 18px 20px;
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.12) 0%, rgba(22, 33, 62, 0.65) 60%);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
}

.dashboard-title {
    font-size: 1.75rem;
    font-weight: 900;
    letter-spacing: -0.4px;
    margin-bottom: 6px;
}

.dashboard-subtitle {
    color: var(--text-secondary);
}

.btn-add-task {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
    color: white;
    text-decoration: none;
    font-weight: 700;
    box-shadow: 0 8px 24px rgba(99, 102, 241, 0.28);
    transition: var(--transition);
    white-space: nowrap;
}

.btn-add-task:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 34px rgba(99, 102, 241, 0.40);
}

/* Dashboard stats cards (used by Dashboard.jsx) */
.stats-card {
    background: linear-gradient(135deg, var(--bg-card) 0%, rgba(22, 33, 62, 0.88) 100%);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    transition: var(--transition);
}

.stats-card:hover {
    transform: translateY(-3px);
    border-color: rgba(99, 102, 241, 0.25);
    box-shadow: var(--shadow-lg);
}

.stats-card-content {
    padding: 18px;
}

.stats-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 14px;
}

.stats-icon {
    width: 40px;
    height: 40px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.stats-trend {
    font-size: 0.85rem;
    font-weight: 700;
    padding: 6px 10px;
    border-radius: 999px;
}

.stats-trend.trend-up {
    color: #10b981;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.22);
}

.stats-trend.trend-down {
    color: #f59e0b;
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.20);
}

.stats-label {
    color: var(--text-secondary);
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 6px;
}

.stats-value {
    font-size: 1.8rem;
    font-weight: 900;
    letter-spacing: -0.4px;
}

/* icon color + light backgrounds used by Dashboard.jsx props */
.text-blue {
    color: #3b82f6;
}

.text-green {
    color: #10b981;
}

.text-purple {
    color: #8b5cf6;
}

.text-orange {
    color: #f59e0b;
}

.bg-blue-light {
    background: rgba(59, 130, 246, 0.18);
}

.bg-green-light {
    background: rgba(16, 185, 129, 0.18);
}

.bg-purple-light {
    background: rgba(139, 92, 246, 0.18);
}

.bg-orange-light {
    background: rgba(245, 158, 11, 0.18);
}

.dashboard-content {
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: 20px;
}

.dashboard-card {
    background: linear-gradient(135deg, var(--bg-card) 0%, rgba(22, 33, 62, 0.92) 100%);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
}

.dashboard-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 18px;
    background: rgba(0, 0, 0, 0.14);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

.card-title {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
}

.card-actions {
    display: flex;
    align-items: center;
    gap: 8px;
}

.more-btn {
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 8px;
    border-radius: 12px;
}

.more-btn:hover {
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-primary);
}

.dashboard-card-content {
    padding: 16px 18px;
}

.schedule-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 12px;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(255, 255, 255, 0.03);
    margin-bottom: 10px;
}

.schedule-item-active {
    border-color: rgba(99, 102, 241, 0.35);
    background: rgba(99, 102, 241, 0.10);
}

.schedule-time {
    min-width: 72px;
    font-weight: 800;
    color: #a78bfa;
}

.schedule-title {
    font-weight: 800;
    margin-bottom: 4px;
}

.schedule-meta {
    color: var(--text-secondary);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
}

.schedule-badge {
    margin-left: auto;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 6px 10px;
    border-radius: 999px;
    background: rgba(99, 102, 241, 0.18);
    color: #c7d2fe;
    border: 1px solid rgba(99, 102, 241, 0.25);
}

.dashboard-page .task-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(255, 255, 255, 0.03);
    margin-bottom: 10px;
}

.task-checkbox {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    border: 2px solid rgba(255, 255, 255, 0.18);
}

.task-title {
    font-weight: 800;
    margin-bottom: 4px;
}

.task-time {
    color: var(--text-secondary);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
}

.task-priority {
    margin-left: auto;
    font-size: 0.72rem;
    padding: 5px 10px;
    border-radius: 999px;
    text-transform: uppercase;
    font-weight: 900;
    letter-spacing: 0.2px;
}

.dashboard-page .exam-item {
    padding: 12px;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(255, 255, 255, 0.03);
    margin-bottom: 10px;
}

.dashboard-page .exam-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
}

.exam-subject {
    font-weight: 900;
}

.exam-days {
    color: var(--text-secondary);
    font-size: 0.85rem;
}

.exam-days.exam-urgent {
    color: #fb7185;
    font-weight: 900;
}

.dashboard-page .exam-progress .progress-bar {
    height: 8px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    overflow: hidden;
}

.dashboard-page .exam-progress .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #34d399 0%, #22d3ee 55%, #818cf8 100%);
    border-radius: 999px;
}

.quick-actions {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
}

.quick-action-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    color: var(--text-primary);
    text-decoration: none;
    transition: var(--transition);
}

.quick-action-btn:hover {
    transform: translateY(-2px);
    border-color: rgba(99, 102, 241, 0.22);
}

@media (max-width: 980px) {
    .dashboard-content {
        grid-template-columns: 1fr;
    }
}

/* ============ RESOURCE LIBRARY (ALIASES FOR EXISTING JSX) ============ */
.resources-page {
    max-width: 1200px;
    margin: 0 auto;
}

.resources-layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 24px;
}

.resources-sidebar {
    background: var(--bg-card);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--radius);
    padding: 14px;
}

.resources-sidebar .divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.06);
    margin: 14px 0;
}

.resources-sidebar .count {
    margin-left: auto;
    font-size: 0.75rem;
    color: var(--text-muted);
}

.folders-section h4 {
    color: var(--text-secondary);
    font-size: 0.85rem;
    font-weight: 800;
    margin-bottom: 10px;
}

.folder-content {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1;
}

.delete-folder {
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 6px;
    border-radius: 10px;
}

.delete-folder:hover {
    background: rgba(255, 255, 255, 0.06);
    color: var(--danger);
}

.resources-toolbar {
    display: flex;
    gap: 12px;
    margin-bottom: 18px;
    flex-wrap: wrap;
}

.type-filters {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.resources-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
}

.resources-page .resource-desc {
    color: var(--text-secondary);
    font-size: 0.85rem;
    margin-bottom: 12px;
}

.resources-page .type-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    padding: 6px 10px;
    border-radius: 999px;
    color: #0b1220;
    font-weight: 800;
}

/* ============ GRADE CALCULATOR (MISSING CLASSES) ============ */
.gpa-bar {
    height: 10px;
    background: rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    overflow: hidden;
    margin-top: 10px;
}

.gpa-fill {
    height: 100%;
    background: linear-gradient(90deg, #34d399 0%, #22d3ee 45%, #818cf8 100%);
    border-radius: 999px;
}

.target-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 10px;
    color: rgba(255, 255, 255, 0.92);
    font-weight: 800;
}

.needed-grade {
    margin-top: 12px;
    padding: 10px 12px;
    border-radius: 14px;
    font-size: 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    justify-content: center;
}

.needed-grade.achievable {
    background: rgba(16, 185, 129, 0.14);
    border: 1px solid rgba(16, 185, 129, 0.24);
    color: #86efac;
}

.needed-grade.not-achievable {
    background: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.22);
    color: #fecaca;
}

.gpa-card.target input[type="number"] {
    width: 92px;
    padding: 10px;
    text-align: center;
    background: rgba(0, 0, 0, 0.22);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 14px;
    color: white;
    font-weight: 800;
}

.gpa-card.stats .stat-row {
    display: flex;
    justify-content: space-between;
    padding: 10px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.88);
}

.gpa-card.stats .stat-row:last-child {
    border-bottom: none;
}

@media (max-width: 980px) {
    .resources-layout {
        grid-template-columns: 1fr;
    }
}

/* ============ BUTTON + TAG UTILS (USED ACROSS PAGES) ============ */
.btn-sm {
    padding: 8px 12px;
    font-size: 0.85rem;
    border-radius: 12px;
}

.btn-ghost {
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-primary);
    border: 1px solid rgba(255, 255, 255, 0.08);
}

.btn-ghost:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.14);
}

.text-success {
    color: var(--success);
}

.text-warning {
    color: var(--warning);
}

.text-primary {
    color: var(--primary);
}

.text-secondary {
    color: var(--text-secondary);
}

.tag-input {
    display: flex;
    gap: 10px;
    align-items: center;
}

.tag-input input {
    flex: 1;
    padding: 10px 12px;
    background: var(--bg-input);
    border: 1px solid var(--border);
    border-radius: 12px;
    color: var(--text-primary);
}

.tag-input input:focus {
    outline: none;
    border-color: var(--primary);
}

.tags-list {
    margin-top: 10px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    color: var(--text-secondary);
    font-size: 0.8rem;
}

.tag button {
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 2px;
    border-radius: 999px;
}

.tag button:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.08);
}

/* ============ MODAL ENHANCEMENTS ============ */
.modal-body {
    padding: 20px;
}

.modal.modal-sm {
    max-width: 420px;
}

.modal.modal-lg {
    max-width: 920px;
}

/* ============ GRADE CALCULATOR (EDITOR/MODAL) ============ */
.weight-total {
    margin-left: 8px;
    color: var(--text-muted);
    font-weight: 600;
    font-size: 0.85rem;
}

.categories-editor {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 12px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 14px;
}

.categories-editor .category-row {
    display: grid;
    grid-template-columns: 1fr 140px 44px;
    gap: 10px;
    align-items: center;
    padding: 10px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
}

.categories-editor .category-row input[type="text"] {
    width: 100%;
    padding: 10px 12px;
    background: var(--bg-input);
    border: 1px solid var(--border);
    border-radius: 12px;
    color: var(--text-primary);
}

.weight-input {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--bg-input);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0 10px;
}

.weight-input input {
    width: 72px;
    padding: 10px 0;
    background: transparent;
    border: none;
    color: var(--text-primary);
    text-align: right;
    outline: none;
}

.weight-input span {
    color: var(--text-muted);
    font-weight: 700;
}

.btn-icon {
    width: 44px;
    height: 44px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--text-secondary);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.btn-icon:hover {
    background: rgba(255, 255, 255, 0.08);
    color: var(--danger);
}

/* ============ HABIT TRACKER (MATCHES CURRENT JSX) ============ */
.habits-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 18px;
    padding: 12px 14px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius);
}

.habits-controls .view-toggle button {
    padding: 8px 12px;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.10);
    color: var(--text-secondary);
    border-radius: 12px;
    cursor: pointer;
    transition: var(--transition);
}

.habits-controls .view-toggle button:hover {
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-primary);
}

.habits-controls .view-toggle button.active {
    background: rgba(99, 102, 241, 0.16);
    border-color: rgba(99, 102, 241, 0.32);
    color: #c7d2fe;
    font-weight: 800;
}

.date-nav {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text-secondary);
    font-weight: 700;
}

.date-nav button {
    width: 34px;
    height: 34px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--text-primary);
    cursor: pointer;
}

.date-nav button:hover {
    background: rgba(255, 255, 255, 0.08);
}

.habits-grid {
    overflow-x: auto;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius);
}

.habits-header,
.habit-row {
    min-width: 860px;
    display: grid;
    grid-template-columns: 260px 1fr 140px;
    gap: 12px;
    align-items: center;
    padding: 12px 14px;
}

.habits-header {
    position: sticky;
    top: 0;
    z-index: 1;
    background: rgba(15, 15, 26, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 0.85rem;
    color: var(--text-secondary);
    font-weight: 900;
}

.habit-row {
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

.habit-row:last-child {
    border-bottom: none;
}

.habit-name-col,
.stats-col {
    color: var(--text-secondary);
}

.dates-cols,
.habit-checks {
    display: flex;
    gap: 8px;
    align-items: center;
}

.date-col {
    width: 42px;
    text-align: center;
    padding: 8px 6px;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(255, 255, 255, 0.03);
}

.date-col.today {
    border-color: rgba(99, 102, 241, 0.28);
    background: rgba(99, 102, 241, 0.10);
}

.habits-page .check-btn {
    width: 42px;
    height: 42px;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
    color: rgba(255, 255, 255, 0.70);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition);
}

.habits-page .check-btn:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.06);
    transform: translateY(-1px);
}

.habits-page .check-btn.completed {
    background: rgba(16, 185, 129, 0.16);
    border-color: rgba(16, 185, 129, 0.30);
    color: #86efac;
}

.habits-page .check-btn.not-target {
    opacity: 0.35;
    cursor: not-allowed;
}

.habits-page .check-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
}

.habit-name {
    display: block;
    font-weight: 900;
}

.habit-checks {
    flex-wrap: nowrap;
}

.habits-page .habit-progress {
    display: flex;
    align-items: center;
    gap: 10px;
}

.habits-page .habit-progress span {
    min-width: 44px;
    text-align: right;
    color: var(--text-secondary);
    font-weight: 800;
}