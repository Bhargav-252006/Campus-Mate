# ═══════════════════════════════════════════════════════════════
#                CAMPUS MATE - SERVER ENVIRONMENT
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values

# ── Server ──
PORT=5000
NODE_ENV=development

# ── LLM Provider ──
# Options: ollama | gemini | bytez | openrouter | huggingface
LLM_PROVIDER=ollama

# ── Ollama (Local - Recommended) ──
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# ── Gemini (Free Cloud Option) ──
# GEMINI_API_KEY=your_gemini_key_here
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_ROUTING_MODEL=gemini-2.5-flash-lite

# ── Cloud Fallbacks (Optional) ──
# BYTEZ_API_KEY=your_bytez_key_here
# OPENROUTER_API_KEY=your_openrouter_key_here
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
# HUGGINGFACE_API_KEY=your_hf_key_here
# HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct

# ── CORS ──
# Comma-separated list of additional allowed origins
# ALLOWED_ORIGINS=https://yourdomain.com,https://your-ngrok-url.ngrok-free.app

# ── Auth (JWT) ──
JWT_SECRET=campus-mate-secret-change-this-in-production
JWT_EXPIRY=7d
