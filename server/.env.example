# ═══════════════════════════════════════════════════════════════
#                CAMPUS MATE - SERVER ENVIRONMENT
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values

# ── Server ──
PORT=5000
NODE_ENV=development

# ── LLM Provider ──
# Options: gemini
LLM_PROVIDER=gemini

# ── Gemini (Primary) ──
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ROUTING_MODEL=gemini-2.5-flash-lite

# ── CORS ──
# Comma-separated list of additional allowed origins
# ALLOWED_ORIGINS=https://yourdomain.com,https://your-ngrok-url.ngrok-free.app

# ── Auth (JWT) ──
JWT_SECRET=campus-mate-secret-change-this-in-production
JWT_EXPIRY=7d

# ── Supabase (Optional, for Supabase JS client flows) ──
# Local Docker Supabase example:
# SUPABASE_URL=http://localhost:8000
# SUPABASE_ANON_KEY=your_local_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_local_service_role_key
# Cloud Supabase example:
# SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
