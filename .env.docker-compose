# ============================================
# Campus Mate — Docker Compose Secrets
# ============================================
# Copy this file to .env.docker-compose and fill in REAL values.
# NEVER commit .env.docker-compose to git — it is in .gitignore.
# ============================================

# ============ NODE ENVIRONMENT ============
NODE_ENV=production
LOG_LEVEL=warn

# ============ DATABASE ============
# Use a strong, randomly generated password (32+ chars)
# Generate with: openssl rand -base64 32
DB_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD_HERE

# ============ REDIS ============
# Leave blank if no Redis auth password
REDIS_PASSWORD=

# ============ JWT & AUTH ============
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_USE_STRONG_JWT_SECRET_HERE
JWT_EXPIRY=24h

# ============ LLM CONFIGURATION ============
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ROUTING_MODEL=gemini-2.5-flash-lite
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ============ WEBHOOKS ============
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET_HERE

# ============ API GATEWAY ============
# Set to your production domain in production
VITE_API_URL=https://api.yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# ============ MONITORING ============
SENTRY_DSN=
DATADOG_API_KEY=
