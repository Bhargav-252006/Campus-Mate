# ============================================
# Campus Mate Microservices — Local Dev Config
# ============================================
# Copy this file to .env.services and fill in your REAL values.
# NEVER commit .env.services to git — it is in .gitignore.
# ============================================

# ============ NODEJS & GENERAL ============
NODE_ENV=development
LOG_LEVEL=debug

# ============ DATABASE ============
# Use a strong password even for local dev
DB_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD
DATABASE_URL=postgresql://postgres:Bhargav%402006@db.fuolmomfenpdtsryvihx.supabase.co:5432/postgres?sslmode=require
# ============ REDIS CACHE ============
REDIS_URL=redis://default:1hjayUlDpULL8uRX4BOkYNg1LQQy7wVr@redis-15182.c10.us-east-1-3.ec2.cloud.redislabs.com:15182
# ============ SERVICE URLS ============
AUTH_SERVICE_URL=http://localhost:3001
CHAT_SERVICE_URL=http://localhost:3002
DATA_SERVICE_URL=http://localhost:3003
ANALYTICS_SERVICE_URL=http://localhost:3004
MEMORY_SERVICE_URL=http://localhost:3005
WEBHOOKS_SERVICE_URL=http://localhost:3006

# ============ AUTHENTICATION ============
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_LOCAL_JWT_SECRET
JWT_EXPIRY=24h

# ============ LLM PROVIDER ============
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# ============ GEMINI ============
# Get your key from: https://aistudio.google.com/app/apikey
# ⚠️ NEVER commit this file with a real key inside
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ROUTING_MODEL=gemini-2.5-flash-lite

# ============ WEBHOOKS ============
WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET

# ============ FRONTEND ============
VITE_API_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000

# ============ ALLOWED ORIGINS (CORS) ============
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost,http://127.0.0.1

# ============ PORTS ============
PORT=3000
AUTH_SERVICE_PORT=3001
CHAT_SERVICE_PORT=3002
DATA_SERVICE_PORT=3003
ANALYTICS_SERVICE_PORT=3004
MEMORY_SERVICE_PORT=3005
WEBHOOKS_SERVICE_PORT=3006

# ============ FEATURE FLAGS ============
FEATURE_REAL_TIME_CHAT=true
FEATURE_MOOD_TRACKING=true
FEATURE_POMODORO=true
FEATURE_VOICE_INPUT=true
FEATURE_FILE_UPLOAD=true
FEATURE_ADVANCED_ANALYTICS=true

# ============ RATE LIMITING ============
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
CHAT_RATE_LIMIT_MAX=15
CHAT_RATE_LIMIT_WINDOW=60000

# ============ DATABASE MIGRATIONS ============
# WARNING: Set to false in production — run migrations manually with a reviewed script
AUTO_MIGRATE=false
